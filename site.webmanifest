{
    "id": "/",
    "name": "NullVPN",
    "short_name": "NullVPN",
    "description": "Private internet for everyone, everywhere.",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "lang": "en",
    "background_color": "#f7e7ce",
    "theme_color": "#f7e7ce",
    "icons": [
        {
            "src": "/favicon.png",
            "sizes": "64x64",
            "type": "image/png"
