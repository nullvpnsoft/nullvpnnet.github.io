#!/usr/bin/env bash
# Blocks commits that look like they contain credentials.
# False positive? Add the path to .secretsallow (regex, one per line),
# or bypass consciously with: git commit --no-verify
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 2
files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0
# shellcheck disable=SC2086
if ! bash tools/check_secrets.sh $files; then
  {
    echo ""
    echo "✖ commit blocked by secrets gate — fix the file(s) above,"
    echo "  add a narrow waiver to .secretsallow,"
    echo "  or bypass consciously with: git commit --no-verify"
  } >&2
  exit 1
fi
exit 0
